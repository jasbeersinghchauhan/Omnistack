{
    "name": "omnistock-backend",
    "version": "1.0.0",
    "description": "Production REST API for Omnistock",
    "main": "src/server.js",
    "scripts": {
        "dev": "nodemon --env-file=.env src/server.js",
        "start": "node --env-file=.env src/server.js",
        "worker": "node --env-file=.env src/infrastructure/queue/product.worker.js",
        "test": "node --env-file=.env --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "Jasbeer Singh Chauhan",
    "license": "MIT",
    "type": "module",
    "dependencies": {
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcrypt": "^6.0.0",
        "body-parser": "^2.3.0",
        "bullmq": "^6.3.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.1",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.11.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.23.0",
        "redis": "^6.2.1",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@prisma/config": "^7.9.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.9.0",
        "jest": "^30.4.2",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.6",
        "prisma": "^7.9.1",
        "supertest": "^7.2.2",
        "t": "^0.5.1",
        "tsx": "^4.23.12"
    },
    "allowScripts": {
        "prisma@7.9.0": true,
        "@prisma/engines@7.9.0": true,
        "bcrypt@6.0.0": true
    }
}
